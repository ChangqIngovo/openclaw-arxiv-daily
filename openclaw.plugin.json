{
  "id": "arxiv-daily",
  "name": "arXiv Daily",
  "version": "0.5.2",
  "description": "Personal Weixin arXiv daily digest, user-selected models, and optional Zotero bookmarks.",
  "categories": [
    "research"
  ],
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "allowedAccountIds"
    ],
    "properties": {
      "allowedAccountIds": {
        "type": "array",
        "minItems": 1,
        "maxItems": 60,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "agentId": {
        "type": "string",
        "default": "arxiv_bot_v1"
      },
      "defaultTopics": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "type": "string"
        },
        "default": [
          "21cm",
          "EoR",
          "high redshift"
        ]
      },
      "defaultLanguage": {
        "enum": [
          "zh",
          "en",
          "none"
        ],
        "default": "zh"
      },
      "sendTime": {
        "type": "string",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
        "default": "08:00"
      },
      "timeZone": {
        "type": "string",
        "default": "system",
        "description": "system follows the computer timezone, including changes while running; an explicit IANA timezone remains fixed."
      },
      "maxSubscribers": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 1
      },
      "lookbackDays": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30,
        "default": 1,
        "description": "Legacy compatibility only; always use the previous calendar day in timeZone. Values greater than 1 are ignored."
      },
      "maxResultsPerQuery": {
        "type": "integer",
        "minimum": 100,
        "maximum": 5000,
        "default": 2000
      },
      "requestIntervalMs": {
        "type": "integer",
        "minimum": 3000,
        "default": 3200
      },
      "zotero": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "credentialsFile": {
            "type": "string",
            "minLength": 1,
            "description": "Local file containing application credentials and encryption key; never paste secret values into plugin config."
          }
        }
      },
      "personal": {
        "type": "boolean",
        "default": true,
        "description": "Personal edition; false is retained only for legacy migration."
      },
      "ownerPeerId": {
        "type": "string",
        "minLength": 1,
        "description": "Trusted peer from the locally logged-in Weixin account, set by the installer."
      }
    }
  }
}
