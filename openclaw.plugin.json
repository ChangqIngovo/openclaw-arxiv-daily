{
  "id": "arxiv-daily",
  "name": "arXiv Daily",
  "version": "0.3.2",
  "description": "Weixin subscription commands, shared arXiv cache, and daily delivery. Ordinary Weixin messages never start an agent turn while this plugin is active.",
  "categories": [
    "research"
  ],
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "allowedAccountIds"
    ],
    "properties": {
      "allowedAccountIds": {
        "type": "array",
        "minItems": 1,
        "maxItems": 60,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "agentId": {
        "type": "string",
        "default": "arxiv_bot_v1"
      },
      "defaultTopics": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "type": "string"
        },
        "default": [
          "21cm",
          "EoR",
          "high redshift"
        ]
      },
      "defaultLanguage": {
        "enum": [
          "zh",
          "en",
          "none"
        ],
        "default": "zh"
      },
      "sendTime": {
        "type": "string",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
        "default": "08:00"
      },
      "timeZone": {
        "type": "string",
        "default": "Asia/Shanghai"
      },
      "maxSubscribers": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 50
      },
      "lookbackDays": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30,
        "default": 1,
        "description": "Legacy compatibility only; always use the previous calendar day in timeZone. Values greater than 1 are ignored."
      },
      "maxResultsPerQuery": {
        "type": "integer",
        "minimum": 100,
        "maximum": 5000,
        "default": 2000
      },
      "requestIntervalMs": {
        "type": "integer",
        "minimum": 3000,
        "default": 3200
      }
    }
  }
}
