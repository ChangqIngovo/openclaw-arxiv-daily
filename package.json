{
  "name": "openclaw-arxiv-daily",
  "version": "0.3.1",
  "description": "Deterministic per-user arXiv subscriptions for OpenClaw Weixin",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "openclaw": {
    "extensions": [
      "./src/index.js"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:installer": "node scripts/build-installer.mjs",
    "check:installer": "node scripts/build-installer.mjs --check"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.11.1",
    "pdfjs-dist": "6.3.289"
  },
  "peerDependencies": {
    "openclaw": "2026.9.6"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ChangqIngovo/openclaw-arxiv-daily.git"
  },
  "homepage": "https://github.com/ChangqIngovo/openclaw-arxiv-daily"
}
